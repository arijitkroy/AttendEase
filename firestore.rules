rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isHRAdmin() {
      return isAuthenticated() && request.auth.token.role == 'HR_ADMIN';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isHRAdmin() || isOwner(userId);
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isHRAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isHRAdmin();
    }

    // Leaves Collection
    match /leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isHRAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status == 'PENDING');
      allow delete: if isHRAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isHRAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if isHRAdmin();
    }
  }
}
